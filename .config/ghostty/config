# ~/.config/ghostty/config
# Reload after editing with  Cmd+Shift+,  (or restart Ghostty).
# See all options:  ghostty +show-config --default --docs | less

# -- Font ----------------------------------------------------------------------
# The font-family lines are managed by the `font` switcher (font.zsh): run
# `font <name>` then reload Ghostty with Cmd+Shift+, . All options are Nerd Fonts.
font-family = "Maple Mono NF"
# 16pt suits a 27" 4K panel (~163 PPI); bump/drop to taste.
font-size = 16
# Maple Mono OpenType features - mirrors your maple-font generator config
# (feature_freeze "enable" set), applied to the installed Maple Mono NF.
# calt+liga     : ligatures + TODO/FIXME/NOTE/INFO/WARN/HACK/ERROR/DEBUG/FATAL/
#                 TRACE/MARK tag badges (write the word with a trailing ':').
# ss03          : match those tags in ANY case (todo, Todo, TODO).
# ss07/08/10/11 : extra >>, double/reverse-arrow, approx-equal and =punctuation
#                 ligatures.
# cv09          : 7 with a middle bar.  cv43: [italic] z/Z with a middle bar.
# cv66          : pipe arrows.
# zero          : dotted zero (Maple's `zero` feature adds the center dot).
font-feature = calt
font-feature = liga
font-feature = ss03
font-feature = ss07
font-feature = ss08
font-feature = ss10
font-feature = ss11
font-feature = cv09
font-feature = cv43
font-feature = cv66
font-feature = zero
# Thickening fattens thin strokes on LOW-DPI screens; on a 4K/retina panel it
# just softens text, so keep it OFF here for crisp glyphs.
font-thicken = false

# Italic / bold faces (also set by the `font` switcher): Monaspace uses its Radon
# (italic) and Xenon (bold) cuts; other fonts use their own faces.
font-family-italic = "Maple Mono NF"
font-family-bold-italic = "Maple Mono NF"
font-family-bold = "Maple Mono NF"

# -- Theme & colors ------------------------------------------------------------
# Default scheme. Switch live with the `theme` shell command (theme list).
theme = GitHub Light Default
background-opacity = 0.96
background-blur = true
# Brighten/dim if the opacity feels off:
# minimum-contrast = 1.1

# -- Cursor --------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false
shell-integration-features = cursor,sudo,title

# -- Window --------------------------------------------------------------------
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-save-state = always
macos-titlebar-style = tabs
mouse-hide-while-typing = true
copy-on-select = clipboard

# -- macOS / keyboard ----------------------------------------------------------
# Make the left Option key send Alt so zsh word-motion bindings work;
# keep right Option for typing special characters.
macos-option-as-alt = left

# -- Quality of life -----------------------------------------------------------
confirm-close-surface = false
quit-after-last-window-closed = true

# -- Keybindings (a few extras; defaults already cover most) --------------------
keybind = cmd+shift+enter=toggle_fullscreen
keybind = cmd+k=clear_screen
