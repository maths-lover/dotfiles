#!/usr/bin/env bash
# sketchybarrc - SketchyBar config, run by sketchybar on start and on `sketchybar --reload`.
# Colours come from the active theme via ~/.local/state/rice/palette.sh, which
# `rice.sh apply` regenerates from the Ghostty theme file on every `theme` switch.
# Reference: https://felixkratz.github.io/SketchyBar/config/bar

PLUGIN_DIR="$CONFIG_DIR/plugins"
PALETTE="$HOME/.local/state/rice/palette.sh"
if [[ -f "$PALETTE" ]]; then source "$PALETTE"; else
  # Fallback so the bar still draws before the first `rice.sh apply`.
  RICE_BG_HEX=0d1117 RICE_FG_0X=0xffe6edf3 RICE_FG_DIM_0X=0xff8b949e RICE_ACCENT_0X=0xff58a6ff RICE_BG_ALT2_0X=0xff21262d RICE_BORDER_0X=0xff30363d
fi
FONT="Maple Mono NF"

# --- the bar itself ------------------------------------------------------------
# 0xee + hex = bar background at ~93% opacity; blur_radius softens what shows through.
sketchybar --bar height=36 position=top sticky=on topmost=off margin=0 \
           color="0xee${RICE_BG_HEX}" blur_radius=20 border_width=0 \
           padding_left=10 padding_right=10 y_offset=0 corner_radius=0

# --- defaults every item inherits ---------------------------------------------
sketchybar --default icon.font="$FONT:Bold:14.0" icon.color="$RICE_FG_0X" \
           label.font="$FONT:Medium:13.0" label.color="$RICE_FG_0X" \
           padding_left=4 padding_right=4 \
           icon.padding_left=8 icon.padding_right=4 label.padding_left=4 label.padding_right=8 \
           background.color="$RICE_BG_ALT2_0X" background.corner_radius=6 background.height=26 \
           background.drawing=off

# --- left: one pill per Mission Control space ------------------------------------
# `space` items know their Mission Control index (associated_space) and get a
# SELECTED env var when that space is active; plugins/space.sh colours them.
for sid in $(yabai -m query --spaces 2>/dev/null | jq -r '.[].index' || seq 1 4); do
  sketchybar --add space "space.$sid" left \
             --set "space.$sid" associated_space="$sid" icon="$sid" \
                   icon.padding_left=10 icon.padding_right=10 label.drawing=off \
                   icon.highlight_color="$RICE_ACCENT_0X" \
                   script="$PLUGIN_DIR/space.sh" \
                   click_script="$HOME/.config/yabai/focus-space $sid"
done

# --- left: focused application (icon from sketchybar-app-font + name) ------------
sketchybar --add item front_app left \
           --set front_app icon.font="sketchybar-app-font:Regular:16.0" \
                 icon.color="$RICE_ACCENT_0X" label.color="$RICE_FG_0X" \
                 background.drawing=off padding_left=12 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# --- right: clock, battery, volume ---------------------------------------------
sketchybar --add item clock right \
           --set clock update_freq=10 icon="󰥔" icon.color="$RICE_FG_DIM_0X" script="$PLUGIN_DIR/clock.sh"
sketchybar --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change
sketchybar --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

sketchybar --update
